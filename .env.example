# Neon PostgreSQL — development branch.
#
# Only DATABASE_URL is required. The pooled form (hostname contains "-pooler")
# is used by the app at runtime; the direct form is used by the Prisma CLI for
# migrations. Whichever one you paste here, the other is derived from it in
# src/lib/db-url.ts.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional — set only if your direct connection differs by more than the
# "-pooler" hostname segment.
# DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js (NextAuth v5). Read from the environment automatically — the names
# matter, so don't rename them.
#
# Signs and encrypts the session JWT. Generate one with `npx auth secret`.
AUTH_SECRET=""

# GitHub OAuth app credentials. Create the app at
# https://github.com/settings/developers with these settings:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional — the app's own origin, used to build the absolute link in the
# verification email. Defaults to http://localhost:3000. Auth.js reads this name
# too, so one value serves both.
# AUTH_URL="https://devstash.example.com"

# Resend, for the "confirm your email" message sent on registration.
# API key from https://resend.com/api-keys.
RESEND_API_KEY=""

# Optional — the sender address. Defaults to Resend's shared
# "DevStash <onboarding@resend.dev>", which only delivers to the Resend account
# owner's own address. Set this to an address on a domain you have verified at
# https://resend.com/domains to reach anyone else.
# EMAIL_FROM="DevStash <noreply@yourdomain.com>"

# Optional — whether a new password account must confirm its email address
# before it can sign in. Defaults to enabled; only "false" or "0" turns it off,
# so a typo here leaves confirmation required.
#
# Set it to "false" while the Resend account above has no verified domain: until
# then the only addresses that can receive the link are the Resend account
# owner's own, which makes registration unusable for everyone else. With it off,
# registration skips the email entirely and the new account is signed-in-ready.
#
# Must be on (unset, or "true") in production — off means anyone can register
# an address they do not control.
# EMAIL_VERIFICATION_ENABLED="false"

# Optional — which account `npm run db:seed` loads the sample content into.
# Defaults to the demo user (demo@devstash.io). Point it at an account you
# actually sign in with to see the seeded items on your own dashboard; that
# account has to exist already, so sign in once first.
# SEED_USER_EMAIL="you@example.com"
