# Neon PostgreSQL — development branch.
#
# Only DATABASE_URL is required. The pooled form (hostname contains "-pooler")
# is used by the app at runtime; the direct form is used by the Prisma CLI for
# migrations. Whichever one you paste here, the other is derived from it in
# src/lib/db-url.ts.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional — set only if your direct connection differs by more than the
# "-pooler" hostname segment.
# DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js (NextAuth v5). Read from the environment automatically — the names
# matter, so don't rename them.
#
# Signs and encrypts the session JWT. Generate one with `npx auth secret`.
AUTH_SECRET=""

# GitHub OAuth app credentials. Create the app at
# https://github.com/settings/developers with these settings:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional — which account `npm run db:seed` loads the sample content into.
# Defaults to the demo user (demo@devstash.io). Point it at an account you
# actually sign in with to see the seeded items on your own dashboard; that
# account has to exist already, so sign in once first.
# SEED_USER_EMAIL="you@example.com"
